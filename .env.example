# Скопируйте этот файл в .env и впишите ключи.

# Ключ OpenAI нужен всегда — для расшифровки аудио (Whisper).
OPENAI_API_KEY=

# Какая модель анализирует разговор по промпту: anthropic | openai | gemini
LLM_PROVIDER=anthropic

# Для LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Для LLM_PROVIDER=gemini (бесплатный ключ: aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Для LLM_PROVIDER=openai (использует OPENAI_API_KEY)
OPENAI_MODEL=gpt-4o

# Необязательно
# Бесплатная расшифровка через Groq: OPENAI_API_KEY=<ключ Groq>, OPENAI_BASE_URL=https://api.groq.com/openai
# WHISPER_MODEL=whisper-large-v3-turbo   (по умолчанию whisper-1)
# MAX_OUTPUT_TOKENS=16000
# PORT=3000
